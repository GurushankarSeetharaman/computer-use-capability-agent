# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Virtualenvs and secrets
.venv/
venv/
env/
.env
# Every .env variant, not just the exact name: a file saved as ".env.txt"
# by a Windows editor is not matched by ".env" and would be committed.
.env.*
!.env.example

# Playwright local state
.playwright/

# Generated run output.
#
# Both directories are produced by running the system, so they are ignored
# wholesale -- except for examples/, which is committed on purpose so the
# repo can be read end to end (artifact + evidence trail) without an API
# key or a live browser. Note git cannot re-include a file inside an
# excluded directory, hence un-ignoring the directory before its contents.
artifacts/*
!artifacts/examples/
!artifacts/examples/**
# evidence/ is the submitted deliverable, so the bundle sits at its top
# level rather than inside an examples/ subfolder -- a reviewer opening
# /evidence/ should see the runs, not a directory to descend into. Live
# runs write run_*/ and replay_*/ siblings, which stay ignored.
evidence/*
!evidence/README.md
!evidence/capability.json
!evidence/discovery/
!evidence/discovery/**
!evidence/replay-success/
!evidence/replay-success/**
!evidence/replay-business-outcome/
!evidence/replay-business-outcome/**
